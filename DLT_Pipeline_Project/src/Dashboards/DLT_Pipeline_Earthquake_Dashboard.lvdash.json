{
  "datasets": [
    {
      "name": "92c992ab",
      "displayName": "DLT_Pipeline_Earthquake_Dataset",
      "queryLines": [
        "select * from silver.earthquake_data_final"
      ],
      "catalog": "dlt_pipeline_project",
      "schema": "default"
    },
    {
      "name": "3beb8836",
      "displayName": "Earthquake_Type",
      "queryLines": [
        "select \n",
        "count(*) as total_magnitude_bucket,\n",
        "magnitude_bucket\n",
        "from (\n",
        "    select case when mag<2 then 'Micro (<2)'\n",
        "    when mag between 2 and 3 then 'Minor (2-3)'\n",
        "    when mag between 3 and 4 then 'Light (3-4)'\n",
        "    else 'Moderate (4+)'\n",
        "    end as magnitude_bucket\n",
        "    from silver.earthquake_data_final\n",
        ")\n",
        "group by magnitude_bucket\n",
        "\n",
        "\n"
      ],
      "catalog": "dlt_pipeline_project",
      "schema": "default"
    },
    {
      "name": "683def38",
      "displayName": "Earthquake_Country_Places",
      "queryLines": [
        "select \n",
        "count(*) as event_count,\n",
        "case when size(split(place,', '))=1 then split(place,', ')[0]\n",
        "else split(place,', ')[1] end as country\n",
        "from (\n",
        "select\n",
        "time,\n",
        "title,\n",
        "mag,\n",
        "longitude,\n",
        "place,\n",
        "latitude\n",
        "from silver.earthquake_data_final\n",
        ")\n",
        "group by country"
      ],
      "catalog": "dlt_pipeline_project",
      "schema": "default"
    }
  ],
